# Whitelist: ignore everything, then allow only project sources and docs.
# Never commit game assets (assets/, mods/), generated code (rebuilt from the
# XEX by build.bat), build output, saves or logs.
/*
!/.gitignore
!/.gitattributes

!/CMakeLists.txt
!/CMakePresets.json
!/eamma_manifest.toml
!/build.bat
!/env.bat
!/play.bat
!/*.md

!/src/
!/config/
!/mods_src/

!/tools/
/tools/__pycache__/

# Launcher (NATIVE-FINISH-DESIGN.md WP10): C# sources only, no build output.
!/launcher/
/launcher/bin/
/launcher/obj/
/launcher/publish/
*.pyc

# Native renderer (NATIVE-PLAN.md EN-2). plume and XenosRecomp are fetched and patched by
# tools/nr_fetch_third_party.py (or copied from UFC's patched tree), not committed.
!/LICENSE
!/cmake/
!/patches/
!/third_party/
/third_party/plume/
/third_party/XenosRecomp/
